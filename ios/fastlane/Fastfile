default_platform(:ios)
skip_docs

CALYMOB_XCODE_CLOUD_WORKFLOW_ID = 'D11B66EC-6E95-43A4-B345-727D1992D72A'

def calymob_app_store_connect_config
  # Single reviewed CalyMob credential source. Do not duplicate/override these
  # identifiers in release skills or bypass this Fastfile with xcrun altool.
  key_id = 'RH75BJ54V4'
  issuer_id = '280e011a-f492-43fb-b0eb-727ddaa8c6c9'
  key_filepath = File.expand_path('~/.private_keys/AuthKey_RH75BJ54V4.p8')
  repo_root = File.realpath(File.expand_path('../..', __dir__))

  UI.user_error!('Canonical App Store Connect key is missing or unreadable') unless File.file?(key_filepath) && File.readable?(key_filepath)
  UI.user_error!('Canonical App Store Connect key must not be a symlink') if File.symlink?(key_filepath)
  resolved_key = File.realpath(key_filepath)
  if resolved_key == repo_root || resolved_key.start_with?("#{repo_root}#{File::SEPARATOR}")
    UI.user_error!('App Store Connect key must live outside the repository')
  end
  key_mode = File.stat(resolved_key).mode & 0o777
  UI.user_error!('Canonical App Store Connect key must have mode 0600') unless key_mode == 0o600

  {
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: resolved_key,
    in_house: false
  }
end

def calymob_app_store_connect_api_key
  app_store_connect_api_key(**calymob_app_store_connect_config)
end

def calymob_connect_api_token
  require 'spaceship'
  config = calymob_app_store_connect_config
  Spaceship::ConnectAPI::Token.create(
    key_id: config[:key_id],
    issuer_id: config[:issuer_id],
    filepath: config[:key_filepath]
  )
end

def verify_ios_store_release(action, options = {})
  require 'json'
  repo_root = File.realpath(File.expand_path('../..', __dir__))
  sh(File.join(repo_root, 'scripts', 'check_build_number_sync.sh'), repo_root, log: false)
  script = File.expand_path('../../scripts/verify_store_release.cjs', __dir__)
  args = ['node', script, '--platform', 'ios', '--action', action]
  args += ['--channel', 'internal'] if options[:channel] == 'internal'
  if action == 'submit'
    UI.user_error!('Explicit version and build are required') unless options[:version] && options[:build]
    args += ['--version', options[:version].to_s, '--build', options[:build].to_s]
  end
  JSON.parse(sh(*args, log: false))
end

platform :ios do
  desc "Print the latest Xcode Cloud run and App Store Connect build (read-only)"
  lane :build_number_status do
    require "spaceship"
    Spaceship::ConnectAPI.token = calymob_connect_api_token
    cloud_response = Spaceship::ConnectAPI.client.test_flight_request_client.get(
      "v1/ciWorkflows/#{CALYMOB_XCODE_CLOUD_WORKFLOW_ID}/buildRuns",
      {
        limit: 1,
        sort: '-number',
        'fields[ciBuildRuns]' => 'number,createdDate,startedDate,finishedDate,sourceCommit,executionProgress,completionStatus'
      }
    )
    cloud_run = cloud_response.body.fetch('data').first
    UI.user_error!('No CalyMob Xcode Cloud build run was found') unless cloud_run
    cloud_attributes = cloud_run.fetch('attributes')
    cloud_number = cloud_attributes.fetch('number')
    source_commit = cloud_attributes.dig('sourceCommit', 'commitSha')
    UI.user_error!('Latest Xcode Cloud run has no numeric build number') unless cloud_number.to_s.match?(/\A\d+\z/)
    UI.user_error!('Latest Xcode Cloud run has no source commit') unless source_commit.to_s.match?(/\A[a-f0-9]{40}\z/i)

    linked_response = Spaceship::ConnectAPI.client.test_flight_request_client.get(
      "v1/ciBuildRuns/#{cloud_run.fetch('id')}/builds",
      { limit: 1, include: 'preReleaseVersion' }
    )
    linked_build = linked_response.body.fetch('data').first
    linked_version = linked_response.body.fetch('included', []).find { |item| item['type'] == 'preReleaseVersions' }

    app = Spaceship::ConnectAPI::App.find("be.calypsodc.calymob")
    UI.user_error!('CalyMob app was not found in App Store Connect') unless app
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      platform: Spaceship::ConnectAPI::Platform::IOS,
      sort: '-uploadedDate',
      limit: 200
    )
    numeric_builds = builds.select { |build| build.version.to_s.match?(/\A\d+\z/) }
    latest = numeric_builds.max_by { |build| build.version.to_i }
    UI.user_error!('No numeric CalyMob iOS build was found in App Store Connect') unless latest
    UI.message("CALYMOB_XCC_WORKFLOW_ID=#{CALYMOB_XCODE_CLOUD_WORKFLOW_ID}")
    UI.message("CALYMOB_XCC_RUN_ID=#{cloud_run.fetch('id')}")
    UI.message("CALYMOB_XCC_BUILD=#{cloud_number}")
    UI.message("CALYMOB_XCC_CREATED_AT=#{cloud_attributes.fetch('createdDate')}")
    UI.message("CALYMOB_XCC_STARTED_AT=#{cloud_attributes['startedDate']}")
    UI.message("CALYMOB_XCC_FINISHED_AT=#{cloud_attributes['finishedDate']}")
    UI.message("CALYMOB_XCC_EXECUTION=#{cloud_attributes.fetch('executionProgress')}")
    UI.message("CALYMOB_XCC_COMPLETION=#{cloud_attributes['completionStatus']}")
    UI.message("CALYMOB_XCC_SOURCE_COMMIT=#{source_commit.downcase}")
    UI.message("CALYMOB_XCC_ASC_BUILD_ID=#{linked_build && linked_build['id']}")
    UI.message("CALYMOB_XCC_ASC_BUILD=#{linked_build && linked_build.dig('attributes', 'version')}")
    UI.message("CALYMOB_XCC_ASC_VERSION=#{linked_version && linked_version.dig('attributes', 'version')}")
    UI.message("CALYMOB_XCC_ASC_PROCESSING=#{linked_build && linked_build.dig('attributes', 'processingState')}")
    UI.message("CALYMOB_ASC_VERSION=#{latest.app_version}")
    UI.message("CALYMOB_ASC_BUILD=#{latest.version}")
  end

  desc "Upload IPA to App Store Connect (TestFlight)"
  lane :deploy do
    UI.user_error!('Local iOS upload is disabled. Build, sign, and distribute only with the reviewed Xcode Cloud workflow.')
  end

  desc "Upload IPA to the editable App Store version without submitting"
  lane :release do
    UI.user_error!('Local iOS upload is disabled. Build, sign, and distribute only with the reviewed Xcode Cloud workflow.')
  end

  desc "Submit uploaded build to App Store Review (uses existing build, no binary upload)"
  lane :submit do |options|
    release = verify_ios_store_release('submit', options)
    verify_ios_store_release('notes')
    api_key = calymob_app_store_connect_api_key

    version = release['version']
    build = release['build']

    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      release_notes: { 'fr-FR' => release['notes'] },
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Update What's New (release notes) on the current editable version via ASC API"
  lane :update_notes do |options|
    approved = verify_ios_store_release('notes')
    require "spaceship"
    Spaceship::ConnectAPI.token = calymob_connect_api_token
    app = Spaceship::ConnectAPI::App.find("be.calypsodc.calymob")
    UI.message("App: #{app.name} (id=#{app.id})")
    version = app.get_edit_app_store_version
    if version.nil?
      UI.message("No editable version — looking at in-review version")
      version = app.get_in_review_app_store_version
    end
    UI.user_error!('Editable store version does not match approved release') unless version && version.version_string == approved['version']
    UI.message("Version: #{version.version_string} — state: #{version.app_store_state}")
    locs = version.get_app_store_version_localizations
    fr = locs.find { |l| l.locale == "fr-FR" }
    notes_path = File.join(File.dirname(__FILE__), "metadata", "fr-FR", "release_notes.txt")
    notes = approved['notes']
    UI.message("Reading notes from #{notes_path}")
    if fr
      fr.update(attributes: { whats_new: notes })
      UI.success("Updated fr-FR whats_new (#{notes.length} chars)")
    else
      version.create_app_store_version_localization(attributes: { locale: "fr-FR", whats_new: notes })
      UI.success("Created fr-FR localization")
    end
  end

  desc "Show App Store review status (editable + in-review + live versions)"
  lane :status do
    require "spaceship"
    Spaceship::ConnectAPI.token = calymob_connect_api_token
    app = Spaceship::ConnectAPI::App.find("be.calypsodc.calymob")
    UI.important("App: #{app.name} (id=#{app.id})")

    edit = app.get_edit_app_store_version
    if edit
      UI.important("Editable: #{edit.version_string} — #{edit.app_store_state}")
      b = edit.build
      UI.message("  Build: #{b ? "#{b.version} (processing=#{b.processing_state})" : "NONE"}")
      fr = edit.get_app_store_version_localizations.find { |l| l.locale == "fr-FR" }
      UI.message("  What's New (fr-FR): #{fr && fr.whats_new ? fr.whats_new.to_s.gsub("\n", " / ")[0..200] : "EMPTY"}")
    else
      UI.message("No editable version")
    end

    rev = app.get_in_review_app_store_version
    UI.important("In review: #{rev ? rev.version_string + " — " + rev.app_store_state : "none"}")

    live = app.get_live_app_store_version
    UI.important("Live: #{live ? live.version_string + " — " + live.app_store_state : "none"}")
  end

  desc "Validate API key connection"
  lane :validate do
    api_key = calymob_app_store_connect_api_key

    # Probeer app info op te halen als validatie
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end
end
