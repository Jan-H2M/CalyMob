default_platform(:android)
skip_docs

def verify_android_store_release(action = 'upload', options = {}, external_submit: false)
  require 'json'
  tooling_root = File.expand_path('../..', __dir__)
  script = File.join(tooling_root, 'scripts', 'verify_store_release.cjs')
  external_root = ENV['CALYMOB_RELEASE_ROOT']
  if external_root && !external_root.empty?
    UI.user_error!('External release root is only allowed for Android submit') unless external_submit
    gate = File.join(tooling_root, 'scripts', 'verify_release_tooling.cjs')
    gate_args = ['node', gate, '--platform', 'android', '--action', 'submit', '--release-root', external_root]
    tooling = JSON.parse(sh(*gate_args, log: false))
    script = tooling.fetch('verifierPath')
  end
  args = ['node', script, '--platform', 'android', '--action', action]
  if action == 'submit'
    UI.user_error!('Explicit version and build are required') unless options[:version] && options[:build]
    args += ['--version', options[:version].to_s, '--build', options[:build].to_s]
  end
  JSON.parse(sh(*args, log: false))
end

platform :android do
  desc "Upload AAB to Google Play Store (Production track)"
  lane :deploy do
    verify_android_store_release
    upload_to_play_store(
      track: 'production',
      aab: '../build/app/outputs/bundle/release/app-release.aab',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: 'draft'
    )
  end

  desc "Submit an existing draft production release after manifest verification"
  lane :submit do |options|
    release = verify_android_store_release('submit', options, external_submit: true)
    verify_android_store_release('notes', {}, external_submit: true)
    upload_to_play_store(
      track: 'production',
      version_code: release['build'].to_i,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      rollout: '1.0',
      release_status: 'completed'
    )
  end

  desc "Validate that the service account can connect to Play Store"
  lane :validate do
    validate_play_store_json_key(
      json_key: ENV.fetch('SUPPLY_JSON_KEY', File.expand_path('~/.private_keys/google-play-deploy.json'))
    )
  end
end
